{
  "expo": {
    "name": "MiniGram",
    "slug": "Minigram",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/minigram-icon.png",
    "scheme": "minigram",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/minigram-icon.png",
      "bundleIdentifier": "com.rahulm.minigram"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/minigram-icon.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.rahulm.minigram",
      "versionCode": 2
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/minigram-icon.png",
          "imageWidth": 90
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-video",
      "./plugins/with-local-development-network.cjs",
      [
        "expo-image-picker",
        {
          "photosPermission": "MiniGram lets you choose photos and videos to share with your community.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "98a327cf-a4b7-4924-be8d-fd8fa6987e3a"
      }
    },
    "owner": "rahulrameshm0"
  }
}
